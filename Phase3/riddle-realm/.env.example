# Copy this file to ".env" and fill real values.
# Never commit ".env" to GitHub.

# --- MongoDB connection ---
# Option A — MongoDB Compass / local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017
#
# Option B — MongoDB Atlas (cloud):
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
#   (Copy from Atlas → Connect → Drivers, or Compass → Atlas connection)
#
# Leave empty here. Put the real value only in your private ".env".
MONGODB_URI=

# Required product database name (do not change)
MONGODB_DB_NAME=Riddles-Game

# Calendar day for Daily Riddle (IANA timezone). Default UTC.
APP_TIMEZONE=UTC

# Backend HTTP port (sandbox preview uses 8080)
PORT=8080
HOST=0.0.0.0

# Public share origin for production links (no trailing slash).
# Example: APP_PUBLIC_URL=https://your-real-domain.com
# Leave empty in local development. Never invent a domain.
APP_PUBLIC_URL=

# development | production
NODE_ENV=development

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# If "true", process exits when MongoDB cannot connect
REQUIRE_DB=false

# --- AI (Phase 22) — server only, never put in frontend ---
AI_API_KEY=
AI_MODEL=
AI_DAILY_FREE_LIMIT=20

# Founder ops (optional CLI): FOUNDER_EMAIL / FOUNDER_USERNAME / FOUNDER_PASSWORD
# Prefer first-time setup via /founder.html when zero founders exist.

# --- Founder private access (Phase 26B) ---
# Create your own strong random secret. Put the REAL value only in local .env
# or your host's environment variables — never commit the real secret.
FOUNDER_ACCESS_KEY=

# Session signing (optional extra)
SESSION_SECRET=

# AI (server only — never put these in frontend JS)
AI_PROVIDER=
# AI_API_KEY and AI_MODEL are above

# Payments — not connected in this phase
PAYMENT_PROVIDER=
PAYMENT_SECRET=
