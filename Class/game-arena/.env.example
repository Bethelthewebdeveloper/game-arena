# Copy to .env on the host. Do not commit real secrets.

# Port the Node process should listen on. Most hosts inject this.
PORT=3000

# Bind address. Use 0.0.0.0 on Render, Railway, Fly, and similar hosts.
HOST=0.0.0.0

# development | production
NODE_ENV=production

# Set true behind HTTPS so session cookies include the Secure flag.
# If unset, production mode enables Secure cookies automatically.
COOKIE_SECURE=true

# Optional writable directory for users.json and scores.json.
# Use a persistent disk mount in production. Defaults to ./data
# DATA_DIR=/var/data/game-arena

# Stable secret used to sign session cookies across serverless instances.
# Set this in Vercel Project Settings → Environment Variables.
SESSION_SECRET=change-me-to-a-long-random-string
